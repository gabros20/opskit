{
  "name": "ops-ui",
  "version": "0.1.0",
  "description": "The human terminal UI for ops — a guided, menu-driven face over the ops.json/3 contract. Humans point-and-pick; agents keep ops <verb> --flags.",
  "type": "module",
  "bin": {
    "ops-ui": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "execa": "^9.5.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
