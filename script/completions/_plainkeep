#compdef plainkeep
# plainkeep — dynamic zsh completion (Tier-1 ergonomics). This file is intentionally tiny and
# stable: all the knowledge lives in Python. It asks `plainkeep __complete` for the candidates that
# fit the words typed so far, so completion tracks the real surface (verbs from plainkeep.json) AND
# your live content (note slugs, task ids) with zero drift.
#
# Install (script/setup does this for you):
#   mkdir -p ~/.zsh/completions && ln -sf ~/plainkeep/script/completions/_plainkeep ~/.zsh/completions/_plainkeep
#   # in ~/.zshrc, before `compinit`:  fpath=(~/.zsh/completions $fpath)
#
# Try it:  plainkeep <Tab>   ·   plainkeep wiki <Tab>   ·   plainkeep wiki open <Tab>   ·   plainkeep task done <Tab>

local -a prior cands
# words[1] is "plainkeep"; take everything after it up to (not including) the word being typed.
prior=(${words[2,CURRENT-1]})
cands=("${(@f)$(plainkeep __complete "${prior[@]}" 2>/dev/null)}")
(( ${#cands} )) || return 1
_describe -t plainkeep-commands 'plainkeep' cands
