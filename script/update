#!/usr/bin/env bash
# script/update — pull engine improvements from the template without touching your content.
#
#   ~/ops/script/update [--remote upstream] [--branch main]
#
# It fetches the template and checks out ONLY the engine paths listed in script/engine.txt — so
# bin/, skills/, the dispatcher, the contract files, and the design docs are refreshed, while your
# wiki/ tasks/ journal/ jobs/registry.json and a lean vault's dropped test/ are left exactly as they
# are. Changes are STAGED, not committed: review `git diff --staged`, then commit when you're happy.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REMOTE="upstream"; BRANCH="main"
while [ $# -gt 0 ]; do
  case "$1" in
    --remote) shift; REMOTE="$1" ;;
    --branch) shift; BRANCH="$1" ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
  esac; shift
done

git -C "$ROOT" remote | grep -qx "$REMOTE" || { echo "no '$REMOTE' remote — run script/setup first" >&2; exit 1; }

printf '\033[1mfetching %s\033[0m\n' "$REMOTE"
git -C "$ROOT" fetch -q "$REMOTE"

printf '\033[1mrefreshing engine paths from %s/%s\033[0m\n' "$REMOTE" "$BRANCH"
while IFS= read -r path; do
  case "$path" in ''|\#*) continue ;; esac
  if git -C "$ROOT" cat-file -e "$REMOTE/$BRANCH:$path" 2>/dev/null; then
    git -C "$ROOT" checkout -q "$REMOTE/$BRANCH" -- "$path" && echo "  ~ $path"
  fi
done < "$ROOT/script/engine.txt"

"$ROOT/ops" help >/dev/null 2>&1 || true   # regenerate ops.json from any new cmd.json
echo
if git -C "$ROOT" diff --cached --quiet; then
  printf '\033[1malready up to date.\033[0m\n'
else
  printf '\033[1mengine updated (staged).\033[0m review then commit:\n'
  echo "  git -C '$ROOT' diff --staged       # what changed"
  echo "  ops doctor                          # confirm healthy"
  echo "  git -C '$ROOT' commit -m 'ops: update engine from upstream'"
fi
