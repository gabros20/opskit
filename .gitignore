# Reference clone of garrytan/gbrain — re-clonable, analyzed for design ideas, not part of this project
ref/

# Harness run artifacts — regenerable, not source
__pycache__/
*.pyc
test/last-run-*.json

# Search index — disposable, rebuilt from content (rm -rf .index && ops index)
.index/

# Run logs — append-only, regenerable
.logs/

# Rendered launchd plists — machine-specific (absolute OPS_HOME paths), regenerated by `ops job apply`
jobs/launchd/

# macOS noise
.DS_Store

# Obsidian (Frontend Zero, Part 3.1) — .obsidian/ config is user-owned and version-controlled, but its
# machine/cache state is not; the local trash and Smart Connections cache are never source of truth.
.obsidian/workspace*.json
.obsidian/cache
.trash/
.smart-env/

# Claude Code writes internal files into skills dirs + its own runtime dirs — keep the adapter, ignore the rest
skills/**/.system/
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/history.jsonl
