{
  "verb": "bookmark",
  "summary": "save a URL as a wiki note (type: bookmark); best-effort title fetch; --archive snapshots to ~/files",
  "usage": "ops bookmark <url> [--note \"<text>\"] [--no-fetch] [--archive]",
  "risk": "safe_write",
  "args": [
    { "name": "url", "required": true },
    { "name": "--note", "required": false },
    { "name": "--no-fetch", "required": false },
    { "name": "--archive", "required": false }
  ],
  "reads": ["<url> (external GET, best-effort)"],
  "writes": ["wiki/bookmarks/", "journal/", "~/files/bookmarks/ (with --archive)"]
}
