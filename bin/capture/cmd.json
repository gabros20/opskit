{
  "verb": "capture",
  "summary": "thought -> inbox (also: pipe stdin)",
  "usage": "plainkeep capture \"<text>\"",
  "risk": "safe_write",
  "args": [
    {
      "name": "text",
      "required": false,
      "default": "stdin"
    }
  ],
  "reads": [],
  "writes": [
    "inbox/",
    "journal/"
  ],
  "hints": "Zero-decision dump of a thought into inbox/ for later triage. Common mistake: using it for an actionable to-do \u2014 use `plainkeep task add` instead.",
  "output": {
    "mode": "scalar",
    "fields": {
      "path": "string",
      "text": "string"
    }
  },
  "dry_run": true
}
