{
  "verb": "sweep",
  "summary": "decay Desktop/Downloads: untouched 7d \u2192 _swept/YYYY-MM/, 60d in _swept \u2192 Trash",
  "usage": "plainkeep sweep [--dry-run]",
  "risk": "safe_write",
  "reads": [
    "~/Desktop",
    "~/Downloads"
  ],
  "writes": [
    "~/Desktop/_swept",
    "~/Downloads/_swept",
    "~/.Trash",
    "journal/"
  ],
  "hints": "Decay Desktop/Downloads: untouched 7d \u2192 _swept/, 60d in _swept \u2192 Trash (never deletes outright). Common mistake: expecting rescue by reopening \u2014 rescue is `plainkeep files ingest`.",
  "output": {
    "mode": "rows",
    "fields": {
      "action": "string",
      "zone": "string",
      "name": "string",
      "bucket": "string"
    }
  },
  "dry_run": true
}
