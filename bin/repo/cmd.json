{
  "verb": "repo",
  "summary": "~/work fleet: health | clone <slug>|--all | adopt <path> --kind <k> | nuke-modules --stale <days>",
  "usage": "ops repo <action> [args]",
  "risk": "safe_write",
  "args": [
    {
      "name": "action",
      "required": false,
      "default": "health"
    }
  ],
  "reads": [
    "~/work/**/.git",
    "wiki/projects/"
  ],
  "writes": [
    "~/work/",
    "wiki/projects/",
    "journal/"
  ],
  "hints": "The ~/work fleet manager: health/clone/adopt/nuke-modules. health exit 1 = repos need attention. Common mistake: adopting into the wrong --kind (products|labs|tools).",
  "output": {
    "mode": "rows",
    "fields": {
      "repo": "string",
      "dirty": "int",
      "has_remote": "bool",
      "unpushed": "int",
      "age_days": "int",
      "flags": "list",
      "clean": "bool"
    }
  }
}
