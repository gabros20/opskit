{
  "verb": "repo",
  "summary": "~/work fleet: health | clone <slug>|--all | adopt <path> --kind <k> | nuke-modules --stale <days>",
  "usage": "ops repo <action> [args]",
  "risk": "safe_write",
  "args": [{ "name": "action", "required": false, "default": "health" }],
  "reads": ["~/work/**/.git", "wiki/projects/"],
  "writes": ["~/work/", "wiki/projects/", "journal/"]
}
