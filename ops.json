{
  "verbs": [
    {
      "verb": "capture",
      "summary": "thought -> inbox (also: pipe stdin)",
      "usage": "ops capture \"<text>\"",
      "risk": "safe_write",
      "args": [
        {
          "name": "text",
          "required": false,
          "default": "stdin"
        }
      ],
      "reads": [],
      "writes": [
        "inbox/",
        "journal/"
      ]
    },
    {
      "verb": "close",
      "summary": "daily close: summarize the day into the journal, flag loose ends",
      "usage": "ops close [--automated]",
      "risk": "safe_write",
      "reads": [
        "tasks/",
        "journal/",
        ".git"
      ],
      "writes": [
        "journal/"
      ]
    },
    {
      "verb": "doctor",
      "summary": "self-check: tools, folders, manifest, adapters, secrets, index (--init creates folders)",
      "usage": "ops doctor [--init]",
      "risk": "read",
      "reads": [
        "bin/",
        "ops.json",
        "AGENTS.md",
        "CLAUDE.md",
        "skills/",
        ".index/"
      ],
      "writes": [
        "(folders only with --init)"
      ]
    },
    {
      "verb": "help",
      "summary": "list verbs / usage for one (rendered from ops.json)",
      "usage": "ops help [verb]",
      "risk": "read",
      "reads": [
        "bin/*/cmd.json"
      ],
      "writes": [
        "ops.json"
      ]
    },
    {
      "verb": "index",
      "summary": "rebuild the search index over wiki (FTS5 + graph; +LanceDB if OPS_VECTORS=1)",
      "usage": "ops index",
      "risk": "safe_write",
      "reads": [
        "wiki/"
      ],
      "writes": [
        ".index/"
      ]
    },
    {
      "verb": "search",
      "summary": "ranked file#heading hits (keyword + graph [+ vectors/rerank])",
      "usage": "ops search \"<query>\"",
      "risk": "read",
      "args": [
        {
          "name": "query",
          "required": true
        }
      ],
      "reads": [
        ".index/",
        "wiki/"
      ],
      "writes": [
        ".logs/queries.jsonl"
      ]
    },
    {
      "verb": "start",
      "summary": "daily start: today's journal, carry-forward open tasks, dashboard",
      "usage": "ops start",
      "risk": "safe_write",
      "reads": [
        "tasks/",
        "inbox/",
        "journal/"
      ],
      "writes": [
        "journal/"
      ]
    },
    {
      "verb": "status",
      "summary": "dashboard: active/waiting tasks, inbox, last index, repo state",
      "usage": "ops status",
      "risk": "read",
      "reads": [
        "tasks/",
        "inbox/",
        "wiki/",
        ".index/"
      ],
      "writes": []
    },
    {
      "verb": "task",
      "summary": "list | add \"<title>\" | show <id> | move <id> <status> | done <id>",
      "usage": "ops task <action> [args]",
      "risk": "safe_write",
      "args": [
        {
          "name": "action",
          "required": false,
          "default": "list"
        }
      ],
      "reads": [
        "tasks/"
      ],
      "writes": [
        "tasks/",
        "journal/"
      ]
    },
    {
      "verb": "triage",
      "summary": "propose filing of inbox/ items into tasks or wiki; human approves",
      "usage": "ops triage [--dry-run|--yes]",
      "risk": "safe_write",
      "args": [
        {
          "name": "mode",
          "required": false,
          "default": "interactive"
        }
      ],
      "reads": [
        "inbox/",
        "wiki/conventions.md"
      ],
      "writes": [
        "tasks/",
        "wiki/notes/",
        "journal/",
        "wiki/conventions.md"
      ]
    },
    {
      "verb": "week",
      "summary": "weekly review: shipped/stalled, repo health, sweep done/ -> done/<year>/",
      "usage": "ops week",
      "risk": "safe_write",
      "reads": [
        "tasks/",
        ".git"
      ],
      "writes": [
        "tasks/done/",
        "journal/"
      ]
    },
    {
      "verb": "wiki",
      "summary": "open <slug> | new <type> <name> | backlinks <slug> | stale | orphans | list",
      "usage": "ops wiki <action> [args]",
      "risk": "safe_write",
      "args": [
        {
          "name": "action",
          "required": false,
          "default": "list"
        }
      ],
      "reads": [
        "wiki/"
      ],
      "writes": [
        "wiki/",
        "journal/"
      ]
    }
  ]
}
