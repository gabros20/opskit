{
  "verbs": [
    {
      "verb": "archive",
      "summary": "retire a dead ~/work repo: git-bundle all history into ~/work/archive/<year>/, mark hub archived",
      "usage": "ops archive <slug>",
      "risk": "safe_write",
      "args": [
        {
          "name": "slug",
          "required": true
        }
      ],
      "reads": [
        "~/work/",
        "wiki/projects/"
      ],
      "writes": [
        "~/work/archive/",
        "wiki/projects/",
        "journal/"
      ]
    },
    {
      "verb": "backup",
      "summary": "verify ~/ops is committed + pushed; nag (exit 1) if at risk. Never pushes for you",
      "usage": "ops backup",
      "risk": "read",
      "reads": [
        ".git"
      ],
      "writes": []
    },
    {
      "verb": "capture",
      "summary": "thought -> inbox (also: pipe stdin)",
      "usage": "ops capture \"<text>\"",
      "risk": "safe_write",
      "args": [
        {
          "name": "text",
          "required": false,
          "default": "stdin"
        }
      ],
      "reads": [],
      "writes": [
        "inbox/",
        "journal/"
      ]
    },
    {
      "verb": "close",
      "summary": "daily close: summarize the day into the journal, flag loose ends",
      "usage": "ops close [--automated]",
      "risk": "safe_write",
      "reads": [
        "tasks/",
        "journal/",
        ".git"
      ],
      "writes": [
        "journal/"
      ]
    },
    {
      "verb": "consolidate",
      "summary": "nightly dream-lite pass: wiki orphans/stale + day digest into the journal",
      "usage": "ops consolidate [--automated]",
      "risk": "safe_write",
      "reads": [
        "wiki/",
        "tasks/",
        "inbox/",
        ".git"
      ],
      "writes": [
        "journal/"
      ]
    },
    {
      "verb": "doctor",
      "summary": "self-check: tools, folders, manifest, adapters, secrets, index (--init creates folders)",
      "usage": "ops doctor [--init]",
      "risk": "safe_write",
      "reads": [
        "bin/",
        "ops.json",
        "AGENTS.md",
        "CLAUDE.md",
        "skills/",
        ".index/"
      ],
      "writes": [
        "(skeleton folders, only with --init)"
      ]
    },
    {
      "verb": "files",
      "summary": "binary assets: ingest [<path>] (\u2192 ~/files + shadow note; iCloud proposed, not written) | open <slug>",
      "usage": "ops files ingest [<path>] | open <slug>",
      "risk": "safe_write",
      "args": [
        {
          "name": "action",
          "required": false,
          "default": "ingest"
        }
      ],
      "reads": [
        "inbox/",
        "wiki/files/"
      ],
      "writes": [
        "~/files/",
        "wiki/files/",
        "journal/"
      ]
    },
    {
      "verb": "help",
      "summary": "list verbs / usage for one (rendered from ops.json)",
      "usage": "ops help [verb]",
      "risk": "read",
      "reads": [
        "bin/*/cmd.json"
      ],
      "writes": [
        "ops.json"
      ]
    },
    {
      "verb": "index",
      "summary": "rebuild the search index over wiki (FTS5 + graph; +LanceDB if OPS_VECTORS=1)",
      "usage": "ops index",
      "risk": "safe_write",
      "reads": [
        "wiki/"
      ],
      "writes": [
        ".index/"
      ]
    },
    {
      "verb": "invoice",
      "summary": "DRAFT an invoice for a client (reads tax-formula.md; computes VAT; never sends)",
      "usage": "ops invoice <client> --amount <net> [--desc \"<text>\"]",
      "risk": "draft_only",
      "args": [
        {
          "name": "client",
          "required": true
        },
        {
          "name": "amount",
          "required": true
        }
      ],
      "reads": [
        "templates/tax-formula.md",
        "wiki/clients/"
      ],
      "writes": [
        "~/files/clients/<slug>/out/",
        "journal/"
      ]
    },
    {
      "verb": "job",
      "summary": "list | run <name> | apply \u2014 scheduler-neutral jobs (\u00a715); apply renders launchd plists",
      "usage": "ops job [list|run <name>|apply]",
      "risk": "safe_write",
      "args": [
        {
          "name": "action",
          "required": false,
          "default": "list"
        }
      ],
      "reads": [
        "jobs/registry.json"
      ],
      "writes": [
        "jobs/launchd/",
        ".logs/jobs/",
        "journal/"
      ]
    },
    {
      "verb": "new",
      "summary": "scaffold a project (wiki hub + ~/work repo) or client (wiki hub + ~/files tree)",
      "usage": "ops new project \"<name>\" [--kind labs|products|tools] | new client \"<name>\"",
      "risk": "safe_write",
      "args": [
        {
          "name": "type",
          "required": true
        },
        {
          "name": "name",
          "required": true
        }
      ],
      "reads": [
        "templates/project-repo/",
        "wiki/"
      ],
      "writes": [
        "wiki/",
        "~/work/",
        "~/files/clients/",
        "journal/"
      ]
    },
    {
      "verb": "repo",
      "summary": "~/work fleet: health | clone <slug>|--all | adopt <path> --kind <k> | nuke-modules --stale <days>",
      "usage": "ops repo <action> [args]",
      "risk": "safe_write",
      "args": [
        {
          "name": "action",
          "required": false,
          "default": "health"
        }
      ],
      "reads": [
        "~/work/**/.git",
        "wiki/projects/"
      ],
      "writes": [
        "~/work/",
        "wiki/projects/",
        "journal/"
      ]
    },
    {
      "verb": "search",
      "summary": "ranked file#heading hits (keyword + graph [+ vectors/rerank])",
      "usage": "ops search \"<query>\"",
      "risk": "read",
      "args": [
        {
          "name": "query",
          "required": true
        }
      ],
      "reads": [
        ".index/",
        "wiki/"
      ],
      "writes": [
        ".logs/queries.jsonl"
      ]
    },
    {
      "verb": "start",
      "summary": "daily start: today's journal, carry-forward open tasks, dashboard",
      "usage": "ops start",
      "risk": "safe_write",
      "reads": [
        "tasks/",
        "inbox/",
        "journal/"
      ],
      "writes": [
        "journal/"
      ]
    },
    {
      "verb": "status",
      "summary": "dashboard: active/waiting tasks, inbox, last index, repo state",
      "usage": "ops status",
      "risk": "read",
      "reads": [
        "tasks/",
        "inbox/",
        "wiki/",
        ".index/"
      ],
      "writes": []
    },
    {
      "verb": "sweep",
      "summary": "decay Desktop/Downloads: untouched 7d \u2192 _swept/YYYY-MM/, 60d in _swept \u2192 Trash",
      "usage": "ops sweep [--dry-run]",
      "risk": "safe_write",
      "reads": [
        "~/Desktop",
        "~/Downloads"
      ],
      "writes": [
        "~/Desktop/_swept",
        "~/Downloads/_swept",
        "~/.Trash",
        "journal/"
      ]
    },
    {
      "verb": "task",
      "summary": "list | add \"<title>\" | show <id> | move <id> <status> | done <id>",
      "usage": "ops task <action> [args]",
      "risk": "safe_write",
      "args": [
        {
          "name": "action",
          "required": false,
          "default": "list"
        }
      ],
      "reads": [
        "tasks/"
      ],
      "writes": [
        "tasks/",
        "journal/"
      ]
    },
    {
      "verb": "triage",
      "summary": "propose filing of inbox/ items into tasks or wiki; human approves",
      "usage": "ops triage [--dry-run|--yes]",
      "risk": "safe_write",
      "args": [
        {
          "name": "mode",
          "required": false,
          "default": "interactive"
        }
      ],
      "reads": [
        "inbox/",
        "wiki/conventions.md"
      ],
      "writes": [
        "tasks/",
        "wiki/notes/",
        "journal/",
        "wiki/conventions.md"
      ]
    },
    {
      "verb": "week",
      "summary": "weekly review: shipped/stalled, repo health, sweep done/ -> done/<year>/",
      "usage": "ops week",
      "risk": "safe_write",
      "reads": [
        "tasks/",
        ".git"
      ],
      "writes": [
        "tasks/done/",
        "journal/"
      ]
    },
    {
      "verb": "wiki",
      "summary": "open <slug> | new <type> <name> | backlinks <slug> | stale | orphans | list",
      "usage": "ops wiki <action> [args]",
      "risk": "safe_write",
      "args": [
        {
          "name": "action",
          "required": false,
          "default": "list"
        }
      ],
      "reads": [
        "wiki/"
      ],
      "writes": [
        "wiki/",
        "journal/"
      ]
    }
  ]
}
