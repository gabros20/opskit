#!/usr/bin/env bash
# ops — the single entrypoint dispatcher (§4.2). Verbs live in bin/<verb>/run.py with a cmd.json
# sidecar; `ops help` renders the surface from those, and the guardrail gates each by its risk.
# OPS_HOME defaults to this repo. The verb set is whatever bin/*/ exists — run `ops help`.
set -euo pipefail
OPS="${OPS_HOME:-$(cd "$(dirname "$0")" && pwd)}"
export OPS_HOME="$OPS"
VERB="${1:-help}"; shift || true
case "$VERB" in -h|--help) VERB=help;; esac

CMD="$OPS/bin/$VERB/run.py"
[ -f "$CMD" ] || { echo "unknown verb: $VERB (try: ops help)" >&2; exit 1; }
# guardrail (§5): enforce the verb's risk class + log the invocation, before anything runs.
python3 "$OPS/bin/lib/guardrail.py" "$VERB" "$@" || exit 1
exec python3 "$CMD" "$@"
